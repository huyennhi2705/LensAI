<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ================= LỚP 1: CAMERA TOÀN MÀN HÌNH ================= -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/ivResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="Captured image" />

        <com.example.lensai.view.BoundingBoxView
            android:id="@+id/boxOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Status chip -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_chip_dark"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="🟢  Ready to scan"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_progress_circle"
            android:indeterminateTint="#22D3EE"
            android:padding="20dp"
            android:visibility="gone" />

        <!-- ========== THANH ĐIỀU KHIỂN TRÊN (Flash + Gallery) ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            android:orientation="horizontal"
            android:gravity="end">

            <ImageButton
                android:id="@+id/btnGallery"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_circle_dark"
                android:src="@android:drawable/ic_menu_gallery"
                android:tint="#ffffff"
                android:contentDescription="Chọn ảnh từ thư viện" />

            <ImageButton
                android:id="@+id/btnFlash"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_dark"
                android:src="@drawable/icon_flash"
                android:tint="#ffffff"
                android:contentDescription="Bật/tắt đèn flash" />
        </LinearLayout>

        <!-- ========== TÌM ĐỒ BẰNG GIỌNG NÓI ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="150dp"
            android:layout_marginHorizontal="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceSearch"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="2"
                android:contentDescription="Tìm đồ vật bằng giọng nói. Chạm hai lần rồi nói tên đồ vật."
                android:text="🎤 Nói đồ cần tìm"
                android:textAllCaps="false"
                android:textSize="18sp"
                app:backgroundTint="#22D3EE"
                android:textColor="#0F172A"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopSearch"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:contentDescription="Dừng tìm kiếm"
                android:text="Dừng"
                android:textAllCaps="false"
                android:textSize="18sp"
                app:backgroundTint="#EF4444"
                android:textColor="#FFFFFF"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ================= LỚP 2: BOTTOM SHEET ================= -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_rounded"
        android:elevation="16dp"
        app:behavior_peekHeight="120dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="40dp">

            <!-- Handle -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="#CBD5E1"
                android:layout_marginBottom="16dp" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Point the camera at the object and press the shutter button."
                    android:textColor="#64748B"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Results -->
            <LinearLayout
                android:id="@+id/layoutResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Card Kết quả chính -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_icon_blue"
                                android:gravity="center"
                                android:text="✨"
                                android:textSize="17sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="Recognition Result"
                                android:textColor="#0F172A"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTranslate"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Translate"
                                android:textAllCaps="false"
                                android:textColor="#1D4ED8"
                                android:textSize="12sp"
                                android:visibility="gone"
                                app:backgroundTint="#DBEAFE"
                                app:cornerRadius="18dp" />
                        </LinearLayout>

                        <!-- Ảnh thu nhỏ -->
                        <ImageView
                            android:id="@+id/ivCapturedPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="12dp"
                            android:background="#1E293B"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:contentDescription="Captured Image" />

                        <!-- Mô tả -->
                        <TextView
                            android:id="@+id/tvResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_result_area"
                            android:lineSpacingExtra="4dp"
                            android:padding="14dp"
                            android:text="Results will appear here..."
                            android:textColor="#1E293B"
                            android:textIsSelectable="true"
                            android:textSize="16sp" />

                        <!-- Nút Nghe -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSpeak"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="12dp"
                            android:text="Nghe đọc"
                            android:textAllCaps="false"
                            android:textColor="#047857"
                            android:textSize="13sp"
                            app:backgroundTint="#D1FAE5"
                            app:cornerRadius="20dp"
                            app:icon="@android:drawable/ic_lock_silent_mode_off"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconTint="#047857" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Danh sách vật thể -->
                <TextView
                    android:id="@+id/tvDetectedObjectsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Object details"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDetectedObjects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_detected_object" />

                <!-- AI Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/aiCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#C7D2FE"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Header AI -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_icon_blue"
                                android:gravity="center"
                                android:text="💡"
                                android:textSize="17sp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="AI Learning Suggestions"
                                    android:textColor="#0F172A"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvAiSubtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Explore more about this object"
                                    android:textColor="#64748B"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ProgressBar
                                android:id="@+id/progressAi"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:indeterminateTint="#6366F1"
                                android:visibility="gone" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAiRefresh"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Refresh"
                                android:textAllCaps="false"
                                android:textColor="#4338CA"
                                android:textSize="12sp"
                                app:backgroundTint="#E0E7FF"
                                app:cornerRadius="18dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAiSuggestion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="4dp"
                            android:text="AI suggestions will appear here..."
                            android:textColor="#334155"
                            android:textIsSelectable="true"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Try asking"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupSuggest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="4dp" />

                        <!-- Ask AI -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:boxCornerRadiusBottomEnd="24dp"
                                app:boxCornerRadiusBottomStart="24dp"
                                app:boxCornerRadiusTopEnd="24dp"
                                app:boxCornerRadiusTopStart="24dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etAiQuestion"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Ask AI about this object..."
                                    android:imeOptions="actionSend"
                                    android:inputType="text"
                                    android:maxLines="1"
                                    android:textSize="14sp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAiAsk"
                                android:layout_width="wrap_content"
                                android:layout_height="52dp"
                                android:layout_marginStart="8dp"
                                android:text="Ask"
                                android:textAllCaps="false"
                                app:backgroundTint="#6366F1"
                                app:cornerRadius="26dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <!-- ===== TEST BUTTONS – XOÁ SAU KHI KIỂM TRA XONG ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:padding="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestTts"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="🔊 Test TTS"
                    android:textAllCaps="false"
                    app:backgroundTint="#6366F1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestVoice"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="🎤 Test Voice"
                    android:textAllCaps="false"
                    app:backgroundTint="#10B981" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>